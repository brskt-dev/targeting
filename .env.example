# Copie este arquivo para `.env` na raiz do repo e preencha sua chave.
# O `.env` é ignorado pelo git (.gitignore já cobre *.env / *.env.local).

# Obrigatório — o Targeting exige LLM real.
OPENAI_API_KEY=sk-your-key-here

# Opcional — modelo OpenAI. Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Opcional — onde gravar dados locais (JSONL + browser profiles).
# Default: ~/.targeting
# TARGETING_DATA_DIR=

# Opcional — CORS da API. Default: *
# CORS_ORIGIN=http://localhost:3000

# Opcional — porta e host da API.
# PORT=3001
# HOST=0.0.0.0

# Opcional — URL que o frontend usa pra chamar a API.
# Default: http://localhost:3001
# NEXT_PUBLIC_API_URL=http://localhost:3001
